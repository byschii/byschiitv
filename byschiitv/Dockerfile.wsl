# ---- builder: compile Go (static) -------------------------------------------
FROM --platform=$BUILDPLATFORM golang:1.23-alpine AS builder

WORKDIR /src
COPY byschiitv/go.mod byschiitv/go.sum ./
RUN go mod download

COPY byschiitv/ .
COPY .env .env
ARG TARGETOS=linux
ARG TARGETARCH
ENV CGO_ENABLED=0
RUN GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -ldflags="-s -w" -o /out/iptvsim .

# ---- final: Debian Linux for WSL -----------------------------------------------
FROM debian:bookworm-slim

# FFmpeg + ca-certificates (standard Linux build)
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ffmpeg ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Non-root user
RUN useradd -m -u 1000 -s /bin/bash app

# App
COPY --from=builder /out/iptvsim /usr/local/bin/iptvsim
COPY --from=builder /src/.env /work/.env
WORKDIR /work
EXPOSE 8080
USER app

ENTRYPOINT ["/usr/local/bin/iptvsim"]
